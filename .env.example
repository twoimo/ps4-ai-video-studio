# PS4 AI Video Studio example configuration
#
# Copy to .env and fill only the values you need. Never commit real API keys,
# studio tokens, account emails, or Chrome profile contents.

# Local HTTP server. Keep loopback unless you add a separate hardened proxy.
HOST=127.0.0.1
PORT=3000

# Leave blank to generate a new >=32-byte random token at process start.
# The server writes it to workspace/.runtime/studio-token with mode 0600.
PS4_STUDIO_TOKEN=
PS4_ALLOWED_ORIGINS=

# CLI/monitor access to the local server.
PS4_API_BASE=http://localhost:3000
PS4_STUDIO_TOKEN_FILE=

# Media tools. Leave blank to use PATH/Homebrew discovery.
FFMPEG_BINARY=
FFPROBE_BINARY=
FFMPEG_FULL_BIN=
YT_DLP_BINARY=
YT_DLP_LANGUAGE=ko

# Future runs use this loopback-only OMLX endpoint for Qwen3.6-27B-8bit
# frame relevance and burned-caption OCR. The optional bearer value is read at
# request time and is never written into run artifacts.
PS4_OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=
PS4_OMLX_PREFLIGHT_TIMEOUT_MS=10000
PS4_OMLX_TIMEOUT_MS=120000

# Optional manual fallback when the channel profile omits the subscriber count.
CHANNEL_SUBSCRIBER_COUNT=

# Optional Gemini text API used only for evidence-bound script generation.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Dedicated Chrome/CDP settings for Gemini web video generation.
# CHROME_PROFILE_DIR must resolve inside ~/.ps4-ai-video-studio/.
CHROME_BINARY=
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=
GEMINI_VIDEO_TIMEOUT_MS=600000
# Headless is the runtime default. Use 0 only for a one-time visible login, then
# fully close that dedicated Chrome before returning this value to 1.
GEMINI_CHROME_HEADLESS=1
# Applies only when HEADLESS=0. Keep 0 when an interactive login is required.
GEMINI_CHROME_BACKGROUND=0

# Optional multi-profile quota monitor. Do not put real emails in committed files.
GEMINI_PROFILE_ROOT=
GEMINI_ACCOUNT_1_EMAIL=account-1
GEMINI_ACCOUNT_1_CDP_URL=http://127.0.0.1:9222
GEMINI_ACCOUNT_1_PROFILE_DIR=
GEMINI_ACCOUNT_2_EMAIL=account-2
GEMINI_ACCOUNT_2_CDP_URL=http://127.0.0.1:9233
GEMINI_ACCOUNT_2_PROFILE_DIR=

# JSON overrides replace the corresponding default arrays when non-empty.
GEMINI_MONITOR_PROFILES_JSON=
GEMINI_MONITOR_SOURCES_JSON=
GEMINI_MONITOR_TOPIC=경복궁 마당이 평평해 보여도 울퉁불퉁한 이유
# Observed quota can permit only two ~10-second clips in one persisted profile.
# Keep one run bound to one profile/session; override up to 12 only when its quota permits.
GEMINI_MONITOR_CLIP_COUNT=2
GEMINI_MONITOR_TARGET_DURATION_SEC=20
GEMINI_MONITOR_INTERVAL_MS=300000
GEMINI_JOB_POLL_INTERVAL_MS=10000
GEMINI_JOB_POLL_WINDOW_MS=600000
GEMINI_MONITOR_MAX_RUNTIME_MS=604800000
GEMINI_MONITOR_RETRY_LIMIT=3
GEMINI_QUOTA_WAKE_LEAD_MS=30000
GEMINI_ULTRAGOAL_SIGNAL_PATH=
GEMINI_AUTOMATED_REVIEW_CHECKPOINT_ROOT=

# Generic local-video executable adapter.
# This must be one executable file path, not a shell command with arguments.
PS4_LOCAL_VIDEO_GENERATOR=
PS4_LOCAL_VIDEO_TIMEOUT_MS=600000

# BFL FLUX 3 adapter. Blank budgets intentionally block live paid generation.
BFL_API_KEY=
BFL_VIDEO_RESOLUTION=hd
BFL_GENERATE_AUDIO=false
BFL_SAFETY_TOLERANCE=2
BFL_MAX_CREDITS=
BFL_ESTIMATED_CREDITS_PER_SECOND=
BFL_ESTIMATED_CREDITS_PER_REQUEST=
BFL_ESTIMATED_TOTAL_CREDITS=
BFL_POLL_INTERVAL_MS=2000
BFL_POLL_TIMEOUT_MS=600000
BFL_MAX_MEDIA_BYTES=536870912
BFL_MEDIA_HOSTS=

# Set to 1 only for a direct adapter contract dry-run. It makes zero network
# requests and does not produce a pipeline-acceptable completed receipt.
BFL_DRY_RUN=0

# Optional macOS say voice settings.
PS4_SAY_RATE=165
PS4_SAY_VOICE=

# Benchmark controls. benchmark:media performs network downloads when run.
BENCHMARK_LIMIT=12
BENCHMARK_SUBS=0
RLM_CHUNK_SIZE=32
